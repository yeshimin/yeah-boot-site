# 将证书路径、静态目录和后端端口替换为实际值后使用。
# 建议先执行 nginx -t，确认无误后再 reload。

server {
    listen 80;
    server_name yeahboot.com www.yeahboot.com docs.yeahboot.com demo.yeahboot.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name www.yeahboot.com;

    ssl_certificate     /etc/ssl/yeahboot/fullchain.pem;
    ssl_certificate_key /etc/ssl/yeahboot/privkey.pem;

    return 301 https://yeahboot.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name yeahboot.com;

    ssl_certificate     /etc/ssl/yeahboot/fullchain.pem;
    ssl_certificate_key /etc/ssl/yeahboot/privkey.pem;

    root /srv/yeahboot/site;
    index index.html;

    location / {
        try_files $uri $uri/ /404.html;
    }

    location ~ ^/(?:docs|nginx|README\.md|\.git) {
        return 404;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}

server {
    listen 443 ssl http2;
    server_name docs.yeahboot.com;

    ssl_certificate     /etc/ssl/yeahboot/fullchain.pem;
    ssl_certificate_key /etc/ssl/yeahboot/privkey.pem;

    root /srv/yeahboot/docs;
    index index.html;

    location / {
        try_files $uri $uri.html $uri/ =404;
    }

    # VitePress构建资源带内容哈希，可以长期缓存
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
}

server {
    listen 443 ssl http2;
    server_name demo.yeahboot.com;

    ssl_certificate     /etc/ssl/yeahboot/fullchain.pem;
    ssl_certificate_key /etc/ssl/yeahboot/privkey.pem;

    root /srv/yeahboot/admin;
    index index.html;
    client_max_body_size 10m;

    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|webp|ico)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
}
